{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/create-checkout-session",
      "destination": "/api/create-checkout-session.js"
    },
    {
      "source": "/api/verify-checkout-session",
      "destination": "/api/verify-checkout-session.js"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook.js"
    },
    {
      "source": "/api/newsletter-subscribe",
      "destination": "/api/newsletter-subscribe.js"
    },
    {
      "source": "/api/newsletter-confirm",
      "destination": "/api/newsletter-confirm.js"
    },
    {
      "source": "/api/save-push-subscription",
      "destination": "/api/save-push-subscription.js"
    },
    {
      "source": "/api/send-push-notification",
      "destination": "/api/send-push-notification.js"
    },
    {
      "source": "/api/vapid-public-key",
      "destination": "/api/vapid-public-key.js"
    },

    {
      "source": "/leistungen",
      "destination": "/api/leistungen.js"
    },
    {
      "source": "/leistungen/:cat",
      "destination": "/api/leistungen.js?cat=:cat"
    },
    {
      "source": "/jobs/:city",
      "destination": "/api/jobs-city.js?city=:city"
    },

    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/nebenjob-finden-in-deiner-region",
      "destination": "/nebenjob-finden-in-deiner-region.html"
    },
    {
      "source": "/blog/haushaltshilfe-finden",
      "destination": "/haushaltshilfe-finden.html"
    },
    {
      "source": "/blog/was-kostet-gartenarbeit",
      "destination": "/was-kostet-gartenarbeit.html"
    },
    {
      "source": "/blog/tipps-fuer-auftraggeber",
      "destination": "/tipps-fuer-auftraggeber.html"
    },
    {
      "source": "/blog/tipps-fuer-helfer",
      "destination": "/tipps-fuer-helfer.html"
    },

    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },

    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
